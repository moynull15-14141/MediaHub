generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ConversionStatus {
  QUEUED
  CONVERTING
  COMPLETED
  FAILED
  CANCELLED
}

model ConversionJob {
  id                String           @id @default(uuid())
  userId            String?
  anonId            String?
  originalFilename  String
  inputFormat       String
  outputFormat      String?
  fileSizeBytes     BigInt?
  durationSeconds   Float?
  resolution        String?
  status            ConversionStatus @default(QUEUED)
  progress          Int              @default(0)
  errorMessage      String?
  inputPath         String?
  outputPath        String?
  createdAt         DateTime         @default(now())
  startedAt         DateTime?
  completedAt       DateTime?
  downloadExpiresAt DateTime?
  updatedAt         DateTime         @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([userId])
  @@index([anonId])
}

enum ImageJobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

model ImageJob {
  id                String         @id @default(uuid())
  userId            String?
  anonId            String?
  originalFilename  String
  inputFormat       String
  outputFormat      String?
  fileSizeBytes     BigInt?
  width             Int?
  height            Int?
  status            ImageJobStatus @default(QUEUED)
  errorMessage      String?
  inputPath         String?
  outputPath        String?
  createdAt         DateTime       @default(now())
  completedAt       DateTime?
  downloadExpiresAt DateTime?
  updatedAt         DateTime       @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([userId])
  @@index([anonId])
}

enum PdfJobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

enum PdfOperation {
  MERGE
  SPLIT
  COMPRESS
  PDF_TO_JPG
  JPG_TO_PDF
  ROTATE
  DELETE_PAGES
  REARRANGE
  PROTECT
  UNLOCK
  EDIT_TEXT
}

model PdfJob {
  id                  String       @id @default(uuid())
  userId              String?
  anonId              String?
  operation           PdfOperation
  originalFilename    String
  inputFormat         String
  outputFormat        String?
  fileSizeBytes       BigInt?
  outputFileSizeBytes BigInt?
  pageCount           Int?
  status              PdfJobStatus @default(QUEUED)
  errorMessage        String?
  resultMessage       String?
  inputPaths          String[]
  thumbnailPaths      String[]
  outputPath          String?
  createdAt           DateTime     @default(now())
  completedAt         DateTime?
  downloadExpiresAt   DateTime?
  updatedAt           DateTime     @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([userId])
  @@index([anonId])
}
