generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ConversionStatus {
  QUEUED
  CONVERTING
  COMPLETED
  FAILED
  CANCELLED
}

model ConversionJob {
  id                String           @id @default(uuid())
  userId            String?
  anonId            String?
  originalFilename  String
  inputFormat       String
  outputFormat      String?
  fileSizeBytes     BigInt?
  durationSeconds   Float?
  resolution        String?
  status            ConversionStatus @default(QUEUED)
  progress          Int              @default(0)
  errorMessage      String?
  inputPath         String?
  outputPath        String?
  createdAt         DateTime         @default(now())
  startedAt         DateTime?
  completedAt       DateTime?
  downloadExpiresAt DateTime?
  updatedAt         DateTime         @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([userId])
  @@index([anonId])
}

enum ImageJobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

model ImageJob {
  id                String         @id @default(uuid())
  userId            String?
  anonId            String?
  originalFilename  String
  inputFormat       String
  outputFormat      String?
  fileSizeBytes     BigInt?
  width             Int?
  height            Int?
  status            ImageJobStatus @default(QUEUED)
  errorMessage      String?
  inputPath         String?
  outputPath        String?
  createdAt         DateTime       @default(now())
  completedAt       DateTime?
  downloadExpiresAt DateTime?
  updatedAt         DateTime       @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([userId])
  @@index([anonId])
}

enum PdfJobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

enum PdfOperation {
  MERGE
  SPLIT
  COMPRESS
  PDF_TO_JPG
  JPG_TO_PDF
  ROTATE
  DELETE_PAGES
  REARRANGE
  PROTECT
  UNLOCK
  EDIT_TEXT
}

model PdfJob {
  id                  String       @id @default(uuid())
  userId              String?
  anonId              String?
  operation           PdfOperation
  originalFilename    String
  inputFormat         String
  outputFormat        String?
  fileSizeBytes       BigInt?
  outputFileSizeBytes BigInt?
  pageCount           Int?
  status              PdfJobStatus @default(QUEUED)
  errorMessage        String?
  resultMessage       String?
  inputPaths          String[]
  thumbnailPaths      String[]
  outputPath          String?
  createdAt           DateTime     @default(now())
  completedAt         DateTime?
  downloadExpiresAt   DateTime?
  updatedAt           DateTime     @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([userId])
  @@index([anonId])
}

enum WhatsappAccountStatus {
  CONNECTED
  DISCONNECTED
  ERROR
}

enum WhatsappHealthStatus {
  HEALTHY
  WARNING
  UNHEALTHY
  UNKNOWN
}

// Phase B.1 - how this account's credentials were obtained. MANUAL covers
// every account connected before this phase (and still available as a
// fallback path); META_EMBEDDED_SIGNUP is the new Meta-official flow.
enum WhatsappConnectionSource {
  MANUAL
  META_EMBEDDED_SIGNUP
}

// Phase B.1 Part 9 - the 4 states the brief explicitly asks the UI to show,
// distinct from the pre-existing WhatsappAccountStatus (CONNECTED/
// DISCONNECTED/ERROR) which the sending engine already reads and which this
// phase does not repurpose. connectionHealth is additive, computed by
// validate/sync, and safe to ignore for any code that only knows the old enum.
enum WhatsappConnectionHealth {
  CONNECTED
  DISCONNECTED
  EXPIRED
  PERMISSION_ERROR
}

model WhatsappAccount {
  id                   String                @id @default(uuid())
  userId               String                @unique
  workspaceId          String
  phoneNumberId        String
  wabaId               String?
  displayPhoneNumber   String?
  businessName         String?
  qualityRating        String?
  healthStatus         WhatsappHealthStatus  @default(UNKNOWN)
  status               WhatsappAccountStatus @default(DISCONNECTED)
  accessTokenEncrypted String
  lastErrorMessage     String?
  lastSyncAt           DateTime?
  defaultCountryCode   String?
  autoSkipDuplicates   Boolean               @default(true)
  rateLimitPerMinute   Int                   @default(20)
  minDelaySeconds      Int                   @default(5)
  maxDelaySeconds      Int                   @default(10)
  maxRetries           Int                   @default(3)
  maxConcurrentJobs    Int                   @default(3)
  sendTimezone         String                @default("UTC")
  batchSize            Int                   @default(1000)
  retryDelaySeconds    Int                   @default(30)
  businessManagerId    String?
  messagingLimitTier   String?
  tokenCreatedAt       DateTime?
  tokenUpdatedAt       DateTime?
  webhookVerified      Boolean               @default(false)
  webhookLastPingAt    DateTime?
  webhookLastDeliveryAt DateTime?
  webhookLastReadAt    DateTime?
  webhookLastErrorAt   DateTime?
  webhookLastErrorMessage String?
  workingHoursEnabled  Boolean               @default(false)
  workingHours         Json?
  defaultTemplateId    String?
  defaultFooter        String?
  defaultAttachmentKey String?
  defaultAttachmentType String?
  defaultAttachmentFilename String?
  defaultAttachmentMimeType String?
  companyName          String?
  logoKey              String?
  language             String                @default("en")
  notifyBrowser        Boolean               @default(true)
  notifyEmail          Boolean               @default(false)
  notifyCampaignCompleted Boolean            @default(true)
  notifyCampaignFailed Boolean               @default(true)
  notifyWebhookOffline Boolean               @default(true)
  notifyQualityDrop    Boolean               @default(true)
  notifyApiFailure     Boolean               @default(true)

  // Phase B.1 - Meta Embedded Signup. All nullable/defaulted so existing
  // manually-connected rows (connectionSource defaults to MANUAL) need no
  // backfill and every pre-existing read of this model is unaffected.
  connectionSource     WhatsappConnectionSource @default(MANUAL)
  connectionHealth     WhatsappConnectionHealth @default(DISCONNECTED)
  verifiedName         String?
  metaBusinessId       String?
  metaBusinessName     String?
  businessVerificationStatus String?
  accountReviewStatus  String?
  grantedScopes        String?
  tokenExpiresAt       DateTime?
  lastValidationAt     DateTime?
  lastValidationStatus String?

  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([workspaceId])
}

// Phase B.1 Part 3 - short-lived, single-use CSRF/replay guard for the Meta
// Embedded Signup callback. Minted server-side when a logged-in user opens
// the Facebook login popup (tied to their workspace+user), consumed exactly
// once when the callback arrives, and rejected once expired - the standard
// double-submit-style defense adapted for a JS-SDK popup flow that never
// goes through a browser redirect (so there is no query-string `state` round
// trip to protect the way a classic OAuth redirect flow would have).
model MetaOAuthState {
  id          String   @id @default(uuid())
  state       String   @unique
  workspaceId String
  userId      String
  used        Boolean  @default(false)
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@index([workspaceId])
  @@index([expiresAt])
}

enum BlacklistReason {
  BLOCKED
  UNSUBSCRIBED
  INVALID
  FAILED
}

model BlacklistedNumber {
  id          String          @id @default(uuid())
  userId      String
  workspaceId String
  phoneNumber String
  reason      BlacklistReason
  note        String?
  createdAt   DateTime        @default(now())

  @@unique([workspaceId, phoneNumber])
  @@index([userId])
  @@index([workspaceId])
  @@index([workspaceId, reason])
}

model AccountAuditLog {
  id          String   @id @default(uuid())
  userId      String
  workspaceId String
  action      String
  detail      String?
  ipAddress   String?
  userAgent   String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([workspaceId])
  @@index([workspaceId, createdAt])
}

// Session/device-level auth history (Phase A.4, Part 4) - deliberately
// separate from AccountAuditLog above: that table is workspace-scoped
// business-action history (campaign sent, role changed, ...), this one is
// per-user authentication history (login/logout/refresh/failed attempts)
// that exists before a workspace is even resolved, and has different
// retention/query needs (e.g. "show my recent sign-ins" is a User query,
// never a Workspace one).
enum AuthEventType {
  LOGIN
  LOGIN_FAILED
  LOGOUT
  LOGOUT_ALL
  TOKEN_REFRESH
  PASSWORD_CHANGE
  REGISTER
}

model AuthEvent {
  id         String        @id @default(uuid())
  userId     String?
  email      String
  event      AuthEventType
  ipAddress  String?
  userAgent  String?
  deviceType String?
  browser    String?
  os         String?
  country    String?
  reason     String?
  createdAt  DateTime      @default(now())

  @@index([userId])
  @@index([email])
  @@index([userId, createdAt])
  @@index([email, event, createdAt])
}

enum ContactStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

model Contact {
  id                 String              @id @default(uuid())
  userId             String
  workspaceId        String
  name               String
  phoneNumber        String
  countryCode        String
  email              String?
  company            String?
  city               String?
  country            String?
  customFields       Json?
  notes              String?
  status             ContactStatus       @default(ACTIVE)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  groups             ContactGroup[]
  labels             ContactLabel[]
  campaignRecipients CampaignRecipient[]

  @@unique([workspaceId, phoneNumber])
  @@index([userId])
  @@index([workspaceId])
  @@index([workspaceId, status])
}

model Group {
  id          String         @id @default(uuid())
  userId      String
  workspaceId String
  name        String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  contacts    ContactGroup[]

  @@unique([workspaceId, name])
  @@index([userId])
  @@index([workspaceId])
}

model Label {
  id          String         @id @default(uuid())
  userId      String
  workspaceId String
  name        String
  color       String         @default("#3b82f6")
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  contacts    ContactLabel[]

  @@unique([workspaceId, name])
  @@index([userId])
  @@index([workspaceId])
}

model ContactGroup {
  contactId String
  groupId   String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  group     Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([contactId, groupId])
  @@index([groupId])
}

model ContactLabel {
  contactId String
  labelId   String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  label     Label   @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([contactId, labelId])
  @@index([labelId])
}

enum ImportSource {
  CSV
  XLSX
  MANUAL
}

model ContactImportBatch {
  id             String       @id @default(uuid())
  userId         String
  workspaceId    String
  filename       String?
  source         ImportSource
  totalRows      Int
  importedCount  Int
  duplicateCount Int
  invalidCount   Int
  skippedCount   Int
  createdAt      DateTime     @default(now())

  @@index([userId])
  @@index([workspaceId])
  @@index([createdAt])
}

enum CampaignStatus {
  DRAFT
  READY
  ARCHIVED
}

enum CampaignType {
  PROMOTIONAL
  UTILITY
  ANNOUNCEMENT
  OTHER
}

enum CampaignRecipientSource {
  GROUP
  LABEL
  MANUAL
}

enum CampaignAttachmentType {
  IMAGE
  PDF
  DOCUMENT
  VIDEO
}

model Campaign {
  id               String              @id @default(uuid())
  userId           String
  workspaceId      String
  name             String
  description      String?
  type             CampaignType        @default(OTHER)
  status           CampaignStatus      @default(DRAFT)
  messageText      String
  templateId       String?
  sendMode         CampaignSendMode?
  scheduledAt      DateTime?
  timezone         String?
  sendStatus       CampaignSendStatus  @default(NOT_STARTED)
  queueStartedAt   DateTime?
  queueCompletedAt DateTime?
  queuePausedAt    DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  recipients       CampaignRecipient[]
  attachment       CampaignAttachment?
  queueJobs        CampaignQueueJob[]

  @@index([userId])
  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([sendStatus])
  @@index([sendStatus, scheduledAt])
  @@index([workspaceId, templateId])
}

enum CampaignSendMode {
  NOW
  SCHEDULED
}

enum CampaignSendStatus {
  NOT_STARTED
  SCHEDULED
  QUEUED
  SENDING
  PAUSED
  COMPLETED
  CANCELLED
  FAILED
}

enum QueueJobStatus {
  PENDING
  WAITING
  SENDING
  SENT
  FAILED
  RETRY
  CANCELLED
  SKIPPED
}

enum MessageDeliveryStatus {
  UNKNOWN
  SENT
  DELIVERED
  READ
  FAILED
}

model CampaignQueueJob {
  id              String                @id @default(uuid())
  campaignId      String
  campaign        Campaign              @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contactId       String
  recipientPhone  String
  recipientName   String
  renderedMessage String
  status          QueueJobStatus        @default(PENDING)
  deliveryStatus  MessageDeliveryStatus @default(UNKNOWN)
  attempts        Int                   @default(0)
  maxAttempts     Int                   @default(3)
  nextAttemptAt   DateTime?
  queuedAt        DateTime              @default(now())
  startedAt       DateTime?
  completedAt     DateTime?
  failedAt        DateTime?
  deliveredAt     DateTime?
  readAt          DateTime?
  errorCode       String?
  errorMessage    String?
  metaMessageId   String?               @unique
  lockedAt        DateTime?
  lockedBy        String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  logs            CampaignSendLog[]

  @@index([campaignId])
  @@index([status])
  @@index([campaignId, status])
  @@index([nextAttemptAt])
}

model CampaignSendLog {
  id           String           @id @default(uuid())
  jobId        String
  job          CampaignQueueJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  campaignId   String
  attempt      Int
  status       QueueJobStatus
  durationMs   Int?
  errorCode    String?
  errorMessage String?
  responseBody Json?
  createdAt    DateTime         @default(now())

  @@index([jobId])
  @@index([campaignId])
}

model CampaignRecipient {
  id         String                  @id @default(uuid())
  campaignId String
  contactId  String
  source     CampaignRecipientSource
  campaign   Campaign                @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact    Contact                 @relation(fields: [contactId], references: [id], onDelete: Cascade)
  createdAt  DateTime                @default(now())

  @@unique([campaignId, contactId])
  @@index([campaignId])
  @@index([contactId])
}

model CampaignAttachment {
  id               String                 @id @default(uuid())
  campaignId       String                 @unique
  campaign         Campaign               @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  type             CampaignAttachmentType
  originalFilename String
  mimeType         String
  fileSizeBytes    BigInt
  storageKey       String
  createdAt        DateTime               @default(now())
}

enum TemplateCategory {
  MARKETING
  PROMOTION
  REMINDER
  GREETING
  ANNOUNCEMENT
  SUPPORT
  INVOICE
  OTP
}

model MessageTemplate {
  id          String           @id @default(uuid())
  userId      String
  workspaceId String
  name        String
  category    TemplateCategory @default(MARKETING)
  messageText String
  isFavorite  Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([workspaceId, name])
  @@index([userId])
  @@index([workspaceId])
  @@index([workspaceId, category])
}

// Phase 6 (Analytics & Reporting). Every statistic elsewhere is computed live
// from existing tables (Campaign, CampaignQueueJob, CampaignSendLog, Contact,
// etc.) - these two models exist only because "when a report should run next"
// and "what reports were generated" are genuinely new facts, not derivable
// from anything already in the schema.
enum ReportFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

enum ReportDataset {
  OVERVIEW
  CAMPAIGNS
  CONTACTS
  TEMPLATES
  QUEUE
  API
  WEBHOOK
}

enum ReportFormat {
  PDF
  XLSX
  CSV
}

model ScheduledReport {
  id          String          @id @default(uuid())
  userId      String
  workspaceId String
  name        String
  frequency   ReportFrequency
  dataset     ReportDataset
  format      ReportFormat
  filters     Json?
  enabled     Boolean         @default(true)
  lastRunAt   DateTime?
  nextRunAt   DateTime
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([userId])
  @@index([workspaceId])
  @@index([enabled, nextRunAt])
}

model ReportHistory {
  id                String        @id @default(uuid())
  userId            String
  workspaceId       String
  scheduledReportId String?
  name              String
  dataset           ReportDataset
  format            ReportFormat
  filters           Json?
  fileSizeBytes     Int
  storageKey        String
  generatedBy       String
  createdAt         DateTime      @default(now())

  @@index([userId])
  @@index([workspaceId])
  @@index([workspaceId, createdAt])
}

// Account store, migrated from a flat server/data/users.json file. `salt` is
// legacy-only: present only on rows not yet re-hashed to bcrypt, and cleared
// the moment a matching legacy login triggers the one-time upgrade (see
// verifyUserCredentials in user.service.ts). Every other model's plain
// `userId String` field (Contact, Campaign, ConversionJob, ...) intentionally
// has no Prisma @relation here - they predate this table and matching by ID
// value alone keeps this migration from touching any of them.
model User {
  id               String            @id @default(uuid())
  email            String            @unique
  passwordHash     String
  salt             String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  cookiePath       String?
  cookieUploadedAt DateTime?
  lastWorkspaceId  String?
  refreshTokens    RefreshToken[]
  workspaceMembers WorkspaceMember[]
}

// Long-lived, revocable session handle backing the short-lived JWT access
// token. Only a hash of the token is ever stored, mirroring how passwords
// are hashed - a leaked database row can't be replayed as a live session.
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Workspace (Phase A.2) - the tenant-isolation boundary every piece of
// WhatsApp business data belongs to. A workspace is created automatically
// for every new user (see registerUser in user.service.ts); WorkspaceMember
// is what makes "one user, many workspaces" and roles possible later without
// another migration. Billing/limit fields are prepared now (Part 9) but
// intentionally unenforced - no billing logic exists yet.
// ---------------------------------------------------------------------------

enum WorkspaceStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum WorkspacePlan {
  FREE
  STARTER
  PRO
  ENTERPRISE
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MANAGER
  OPERATOR
  VIEWER
}

enum WorkspaceInviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

model Workspace {
  id            String                @id @default(uuid())
  name          String
  slug          String                @unique
  logo          String?
  email         String?
  phone         String?
  website       String?
  address       String?
  taxId         String?
  timezone      String                @default("UTC")
  country       String?
  language      String                @default("en")
  currency      String                @default("USD")
  businessType  String?
  status        WorkspaceStatus       @default(ACTIVE)
  plan          WorkspacePlan         @default(FREE)
  storageUsedBytes  BigInt            @default(0)
  storageLimitBytes BigInt            @default(5368709120)
  messageUsed   Int                   @default(0)
  messageLimit  Int                   @default(1000)
  contactLimit  Int                   @default(1000)
  campaignLimit Int                   @default(50)
  memberLimit   Int                   @default(5)
  createdBy     String
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  members       WorkspaceMember[]
  invitations   WorkspaceInvitation[]

  @@index([slug])
  @@index([status])
}

model WorkspaceMember {
  id          String        @id @default(uuid())
  workspaceId String
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        WorkspaceRole @default(OWNER)
  isActive    Boolean       @default(true)
  joinedAt    DateTime      @default(now())

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([workspaceId])
  @@index([workspaceId, role])
}

model WorkspaceInvitation {
  id          String                @id @default(uuid())
  workspaceId String
  workspace   Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email       String
  role        WorkspaceRole         @default(OPERATOR)
  token       String                @unique
  status      WorkspaceInviteStatus @default(PENDING)
  invitedBy   String
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime              @default(now())

  @@index([workspaceId])
  @@index([email])
  @@index([workspaceId, status])
}

// ---------------------------------------------------------------------------
// RBAC (Phase A.3). Roles themselves stay the WorkspaceRole enum introduced
// in Phase A.2 (Owner/Admin/Manager/Operator/Viewer) rather than a redundant
// dynamic Role table - there is no "create a custom role" feature, so a
// second source of truth for the same 5 values would just be duplication.
// Permission is the catalog (seeded from PERMISSION_CATALOG in
// permission.service.ts); RolePermission is the default role -> permission
// matrix (also seeded); UserPermission is a future-ready per-user override
// within one workspace - not yet exposed through any endpoint, but the
// resolver already supports it so adding that later needs no schema change.
// ---------------------------------------------------------------------------

model Permission {
  id          String   @id @default(uuid())
  key         String   @unique
  module      String
  action      String
  description String?
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]
  userPermissions UserPermission[]

  @@index([module])
}

model RolePermission {
  id           String        @id @default(uuid())
  role         WorkspaceRole
  permissionId String
  permission   Permission    @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([role, permissionId])
  @@index([role])
}

model UserPermission {
  id           String     @id @default(uuid())
  workspaceId  String
  userId       String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  grant        Boolean    @default(true)
  createdAt    DateTime   @default(now())

  @@unique([workspaceId, userId, permissionId])
  @@index([workspaceId, userId])
}
