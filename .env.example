# Postgres connection string
DATABASE_URL="postgresql://mediahub:mediahub@localhost:5432/mediahub"

# Cloudflare R2 (S3-compatible) storage for uploaded/converted video files
R2_ACCOUNT_ID="your-r2-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="mediahub"
R2_ENDPOINT="https://your-r2-account-id.r2.cloudflarestorage.com"

# Converter tuning (optional - defaults shown)
MAX_UPLOAD_MB=2048
CONVERTER_DOWNLOAD_TTL_HOURS=24

# PDF Studio tuning (optional - defaults shown)
PDF_MAX_UPLOAD_MB=300
PDF_DOWNLOAD_TTL_HOURS=24

# WhatsApp Campaign - AES-256-GCM key used to encrypt the WhatsApp Business
# access token at rest. Required. Generate with: openssl rand -base64 32
WHATSAPP_TOKEN_ENCRYPTION_KEY=""

# WhatsApp Campaign tuning (optional - defaults shown)
WHATSAPP_GRAPH_API_VERSION=v20.0
WHATSAPP_IMPORT_MAX_UPLOAD_MB=10

# WhatsApp Campaign - Meta webhook subscription (Phase 4 delivery tracking).
# Required for the GET verification handshake at /api/whatsapp/webhook.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
# Optional - if set, X-Hub-Signature-256 on incoming webhook POSTs is
# verified. Required (same value) for Meta Embedded Signup's authorization
# code exchange below - a Meta app has one secret used for both.
WHATSAPP_APP_SECRET=""

# WhatsApp Embedded Signup (Phase B.1) - from Meta App Dashboard > WhatsApp >
# Embedded Signup. appId/configId are public identifiers, safe to serve to
# the frontend. Leave unset to keep the manual connect flow as the only
# option; the "Connect with Facebook" button shows a "not configured" state
# instead of erroring.
META_APP_ID=""
META_WHATSAPP_CONFIG_ID=""

# Only needed when the frontend is deployed separately from the backend
# (e.g. frontend on Vercel, backend on Render) - set to the backend's public URL.
# Leave unset for a same-origin/self-hosted deployment.
VITE_API_URL=""

# Auth - signs/verifies JWT access + refresh tokens. Falls back to an
# insecure development default if unset; ALWAYS set this explicitly before
# real production use. Generate with: openssl rand -base64 32
JWT_SECRET=""

# Production Infrastructure (Phase A.4) - all optional, defaults shown.
NODE_ENV=production
PORT=3000
# Comma-separated list to lock CORS down to specific origins. Leave unset to
# keep the existing reflect-any-origin behavior (needed today - no fixed
# frontend origin is configured).
CORS_ALLOWED_ORIGINS=""
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
BRUTE_FORCE_MAX_ATTEMPTS=5
BRUTE_FORCE_LOCKOUT_MS=900000
REQUEST_BODY_LIMIT="2mb"
TRUST_PROXY=true

# SMTP (optional) - powers Phase B.2's WhatsApp account owner-notification
# emails (health failover, token expiring soon). All four of host/port/user/
# password must be set for email sending to activate; otherwise it silently
# no-ops (logged, never throws).
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="MediaHub <no-reply@mediahub.local>"
SMTP_SECURE=false

# Redis (optional) - no code path currently requires this; reserved for a
# future distributed cache/rate-limit store if this app ever runs as more
# than one instance.
REDIS_URL=""
